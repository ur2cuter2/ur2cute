          "sourceId": "heian_004"
        }
      ]
    },
    {
      "id": "heian_p002",
      "half": "first",
      "order": 2,
      "title": "平安時代の新しい仏教",
      "text": "{{b1}}は延暦寺を建立し、{{b2}}を広めた。一方、{{b3}}は金剛峯寺を建立し、{{b4}}を広めた。",
      "blanks": [
        {
