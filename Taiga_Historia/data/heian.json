    },
    {
      "id": "heian_p010",
      "half": "second",
      "order": 4,
      "title": "源頼朝と武士のしくみ",
      "text": "平氏が滅んだ後、源頼朝は国ごとに{{b1}}を置き、荘園には{{b2}}を置いた。これらに任命された源頼朝の家来を{{b3}}という。",
      "blanks": [
        {
          "id": "b1",
          "sourceId": "heian_031"
