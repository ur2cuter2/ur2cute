      ]
    },
    {
      "id": "heian_p003",
      "half": "first",
      "order": 3,
      "title": "藤原氏の政治と摂政",
      "text": "藤原氏は、娘を天皇のきさきにし、生まれた子を天皇として勢力を伸ばした。この政治を{{b1}}という。天皇が幼少のときにつく役職は{{b2}}で、藤原氏で最初にこの役職についたのは{{b3}}である。",
      "blanks": [
        {
          "id": "b1",
          "sourceId": "heian_009"
        },
        {
          "id": "b2",
          "sourceId": "heian_010"
        },
        {
          "id": "b3",
          "sourceId": "heian_011"
        }
      ]
    },
    {
      "id": "heian_p004",
      "half": "first",
      "order": 4,
      "title": "関白の始まり",
      "text": "藤原氏が成人した天皇を助けるためについた役職は{{b1}}である。藤原氏で初めてこの役職についたのは{{b2}}である。",
      "blanks": [
        {
          "id": "b1",
          "sourceId": "heian_012"
        },
        {
          "id": "b2",
          "sourceId": "heian_013"
        }
      ]
    },
    {
      "id": "heian_p005",
      "half": "first",
      "order": 5,
      "title": "荘園と藤原氏の最盛期",
      "text": "荘園では、税を納めなくてもよい{{b1}}や、国司の立ち入りを拒む{{b2}}という権利が認められるようになった。また、藤原氏で最も力を持ち、「この世をば　わが世とぞ思う」と詠んだのは{{b3}}であり、その子で平等院鳳凰堂を建立したのは{{b4}}である。",
      "blanks": [
        {
          "id": "b1",
          "sourceId": "heian_014"
        },
        {
          "id": "b2",
          "sourceId": "heian_015"
        },
        {
          "id": "b3",
          "sourceId": "heian_016"
        },
        {
          "id": "b4",
          "sourceId": "heian_017"
        }
      ]
    },
    {
      "id": "heian_p006",
      "half": "first",
      "order": 6,
      "title": "10世紀の地方の反乱",
      "text": "10世紀、関東地方で反乱を起こし、新皇と称したのは{{b1}}である。また、瀬戸内地方で反乱を起こしたのは{{b2}}である。",
      "blanks": [
        {
          "id": "b1",
          "sourceId": "heian_018"
        },
        {
          "id": "b2",
          "sourceId": "heian_019"
        }
      ]
    },
    {
      "id": "heian_p007",
      "half": "second",
      "order": 1,
      "title": "地方政治の乱れと院政・争乱",
      "text": "尾張の国司だった{{b1}}は、農民たちに訴えられ、解任された。その後、1086年に{{b2}}が院政を始めた。1156年には天皇と上皇の対立から{{b3}}が起こり、1159年には平清盛と源義朝の対立から{{b4}}が起こった。",
      "blanks": [
        {
          "id": "b1",
          "sourceId": "heian_020"
        },
        {
          "id": "b2",
          "sourceId": "heian_021"
        },
        {
          "id": "b3",
          "sourceId": "heian_022"
        },
        {
          "id": "b4",
          "sourceId": "heian_023"
        }
      ]
    },
    {
      "id": "heian_p008",
      "half": "second",
      "order": 2,
      "title": "平清盛と中国との貿易",
      "text": "平清盛は武士として初めて{{b1}}の役職についた。また、中国との貿易のために港の{{b2}}を改築した。当時、交易相手の中国の王朝は{{b3}}であった。",
      "blanks": [
        {
          "id": "b1",
          "sourceId": "heian_024"
        },
        {
          "id": "b2",
          "sourceId": "heian_025"
        },
        {
          "id": "b3",
          "sourceId": "heian_026"
        }
      ]
    },
    {
      "id": "heian_p009",
      "half": "second",
      "order": 3,
      "title": "源平の戦い",
      "text": "平氏を滅ぼすため、伊豆で挙兵したのは{{b1}}である。屋島などで平氏を破ったのは{{b2}}であり、1185年に平氏は{{b3}}で滅びた。この戦いの舞台となった壇ノ浦があるのは現在の{{b4}}である。",
      "blanks": [
        {
          "id": "b1",
          "sourceId": "heian_027"
        },
        {
          "id": "b2",
          "sourceId": "heian_028"
        },
